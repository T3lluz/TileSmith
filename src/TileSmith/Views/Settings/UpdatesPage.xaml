<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TileSmith.Views.Settings.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="4">
        <!-- Hero, like Windows Update -->
        <Grid Padding="4,0,0,20" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="64" Height="64">
                <FontIcon x:Name="HeroIcon" Glyph="&#xE895;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <ProgressRing x:Name="HeroRing" Width="64" Height="64" IsActive="False" Visibility="Collapsed" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="HeroTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="You're up to date" />
                <TextBlock x:Name="HeroSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <ProgressBar x:Name="HeroProgress" Visibility="Collapsed" Margin="0,8,0,0" Maximum="100" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
            </StackPanel>
            <Button x:Name="HeroButton" Grid.Column="2" VerticalAlignment="Center" MinWidth="160" Style="{StaticResource AccentButtonStyle}"
                    Content="Check for updates" Click="HeroButton_Click" />
        </Grid>

        <toolkit:SettingsExpander x:Name="NotesExpander" Header="What's new" Visibility="Collapsed" IsExpanded="True">
            <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE789;" /></toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>

        <TextBlock Text="Options" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,16,0,4" />
        <toolkit:SettingsCard Header="Check for updates automatically" Description="Every few hours, from GitHub Releases.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE895;" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="AutoCheckToggle" Toggled="AutoCheckToggle_Toggled" />
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Download updates in the background" Description="Then a single click restarts into the new version.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE896;" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="AutoDownloadToggle" Toggled="AutoDownloadToggle_Toggled" />
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Release history" Description="All versions and their notes on GitHub."
                              IsClickEnabled="True" Click="Releases_Click" ActionIcon="{x:Null}">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE81C;" /></toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
        </toolkit:SettingsCard>
    </StackPanel>
</UserControl>
