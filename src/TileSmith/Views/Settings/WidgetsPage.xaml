<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TileSmith.Views.Settings.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="4">
        <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" Margin="0,0,0,8" />

        <TextBlock Text="Your widgets" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,4" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="1,0,0,8"
                   Text="Rearrange and resize tiles right in the panel with the pencil button. Right-click a tile for more options." />
        <StackPanel x:Name="WidgetList" Spacing="4" />

        <TextBlock Text="Backup and sharing" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,24,0,4" />
        <toolkit:SettingsCard Header="Export widgets" Description="Save all widgets to a .json file to back them up or share them.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEDE1;" /></toolkit:SettingsCard.HeaderIcon>
            <Button Content="Export…" Click="Export_Click" />
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Import widgets" Description="Add widgets from a .json file. Check what they run before importing files from others.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B5;" /></toolkit:SettingsCard.HeaderIcon>
            <Button Content="Import…" Click="Import_Click" />
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Helper scripts folder" Description="Scripts the AI writes for your widgets live here.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></toolkit:SettingsCard.HeaderIcon>
            <Button Content="Open folder" Click="OpenTools_Click" />
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Start over" Description="Replace all widgets with the starter set.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE777;" /></toolkit:SettingsCard.HeaderIcon>
            <Button Content="Reset widgets" Click="Reset_Click" />
        </toolkit:SettingsCard>
    </StackPanel>
</UserControl>
