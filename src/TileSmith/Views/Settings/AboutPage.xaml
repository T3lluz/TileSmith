<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TileSmith.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="4">
        <toolkit:SettingsExpander x:Name="AboutExpander" Header="TileSmith" IsExpanded="True"
                                  Description="AI-built quick settings for Windows">
            <toolkit:SettingsExpander.HeaderIcon>
                <BitmapIcon x:Name="AppBitmap" ShowAsMonochrome="False" />
            </toolkit:SettingsExpander.HeaderIcon>
            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard Header="Source code and releases" IsClickEnabled="True" Click="Repo_Click">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Report a problem or suggest an idea" IsClickEnabled="True" Click="Issues_Click">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Logs" Description="Useful when something doesn't work." IsClickEnabled="True" Click="Logs_Click">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Settings and widgets folder" IsClickEnabled="True" Click="Data_Click">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>

        <TextBlock Text="Built with" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,24,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="1,0,0,0"
                   Text="Windows App SDK and WinUI 3 · Windows Community Toolkit · Velopack · SSH.NET · Segoe Fluent Icons. Works with Hermes Agent, any OpenAI-compatible API, Claude Code and Cursor Agent." />
    </StackPanel>
</UserControl>
