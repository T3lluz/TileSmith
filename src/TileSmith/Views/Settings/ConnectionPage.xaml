<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TileSmith.Views.Settings.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="4">
        <!-- ── AI engine ─────────────────────────────────────────── -->
        <TextBlock Text="AI" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,4" />
        <toolkit:SettingsCard x:Name="EngineCard" Header="AI engine" Description="Which model builds your widgets.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Name="EngineCombo" MinWidth="260" SelectionChanged="EngineCombo_SelectionChanged" />
        </toolkit:SettingsCard>

        <!-- Claude / Cursor subscription -->
        <StackPanel x:Name="LocalPanel" Spacing="4" Visibility="Collapsed">
            <toolkit:SettingsCard x:Name="AccountCard" Header="Account" Description="Checking…">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77B;" /></toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshAccountButton" Content="Refresh" Click="RefreshAccount_Click" />
                    <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource AccentButtonStyle}" Click="SignIn_Click" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Model" Description="Leave empty for the default. Examples: opus, sonnet, gpt-5, claude-opus-4-8.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE950;" /></toolkit:SettingsCard.HeaderIcon>
                <TextBox x:Name="LocalModelBox" MinWidth="260" PlaceholderText="Default" LostFocus="LocalModelBox_LostFocus" />
            </toolkit:SettingsCard>
        </StackPanel>

        <!-- Hermes -->
        <StackPanel x:Name="HermesPanel" Spacing="4" Visibility="Collapsed">
            <toolkit:SettingsCard Header="Hermes command" Description="Runs as: hermes chat --query-file &lt;prompt&gt; on your server.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE756;" /></toolkit:SettingsCard.HeaderIcon>
                <TextBox x:Name="HermesCommandBox" MinWidth="260" PlaceholderText="hermes" LostFocus="HermesBoxes_LostFocus" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Extra arguments" Description="Optional, e.g. --provider openrouter -m anthropic/claude-sonnet-4.5">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE943;" /></toolkit:SettingsCard.HeaderIcon>
                <TextBox x:Name="HermesArgsBox" MinWidth="260" LostFocus="HermesBoxes_LostFocus" />
            </toolkit:SettingsCard>
        </StackPanel>

        <!-- OpenAI-compatible -->
        <StackPanel x:Name="OpenAiPanel" Spacing="4" Visibility="Collapsed">
            <toolkit:SettingsCard Header="API address" Description="As seen from the server when tunnelling. Hermes API: http://127.0.0.1:8642/v1 · Ollama: http://127.0.0.1:11434/v1">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></toolkit:SettingsCard.HeaderIcon>
                <TextBox x:Name="BaseUrlBox" MinWidth="300" LostFocus="OpenAiBoxes_LostFocus" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Connect through the SSH server" Description="Use when the API only listens on the server itself (most setups).">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72E;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="TunnelToggle" Toggled="TunnelToggle_Toggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="API key" Description="Optional. Stored encrypted for your Windows account.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D7;" /></toolkit:SettingsCard.HeaderIcon>
                <PasswordBox x:Name="ApiKeyBox" MinWidth="300" PasswordChanged="ApiKeyBox_PasswordChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Model">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE950;" /></toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Load models" Click="LoadModels_Click" />
                    <ComboBox x:Name="ModelCombo" MinWidth="260" IsEditable="True" TextSubmitted="ModelCombo_TextSubmitted" SelectionChanged="ModelCombo_SelectionChanged" />
                </StackPanel>
            </toolkit:SettingsCard>
        </StackPanel>

        <!-- Custom command -->
        <toolkit:SettingsCard x:Name="CommandPanel" Header="Command on the server" Visibility="Collapsed"
                              Description="The prompt is piped to stdin, or use {file} for a prompt file. e.g. claude -p · ollama run qwen3 · llm -m gpt-5">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE756;" /></toolkit:SettingsCard.HeaderIcon>
            <TextBox x:Name="CustomCommandBox" MinWidth="300" LostFocus="CustomCommandBox_LostFocus" />
        </toolkit:SettingsCard>

        <toolkit:SettingsCard Header="What the agent may do" Description="The agent runs PowerShell, edits files and tests actions on this PC to build your widgets.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEA18;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Name="PermissionCombo" MinWidth="260" SelectionChanged="PermissionCombo_SelectionChanged">
                <ComboBoxItem Content="Work freely (admin still asks via UAC)" Tag="auto" />
                <ComboBoxItem Content="Ask before commands and file changes" Tag="ask" />
            </ComboBox>
        </toolkit:SettingsCard>

        <toolkit:SettingsCard x:Name="TestCard" Header="Test the AI" Description="Sends a tiny prompt and shows how long the reply took.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></toolkit:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="TestRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                <Button x:Name="TestButton" Content="Send a test" Click="Test_Click" />
            </StackPanel>
        </toolkit:SettingsCard>

        <!-- ── Server ─────────────────────────────────────────────── -->
        <TextBlock Text="Server" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,24,0,4" />
        <InfoBar x:Name="ServerStatusBar" IsOpen="True" IsClosable="False" Margin="0,0,0,4">
            <InfoBar.ActionButton>
                <Button x:Name="TrustKeyButton" Content="Trust the new key" Visibility="Collapsed" Click="TrustKey_Click" />
            </InfoBar.ActionButton>
        </InfoBar>
        <toolkit:SettingsExpander Header="SSH server" IsExpanded="True"
                                  Description="Where your AI lives — reachable over SSH, for example through Tailscale. Also used by widgets that run commands on the server.">
            <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE968;" /></toolkit:SettingsExpander.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="ConnectRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource AccentButtonStyle}" Click="Connect_Click" />
            </StackPanel>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard Header="Address" Description="user@hostname or user@100.x.y.z — add :port if it isn't 22">
                    <TextBox x:Name="AddressBox" MinWidth="280" PlaceholderText="you@your-server" LostFocus="AddressBox_LostFocus" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="TailnetCard" Header="Pick from your tailnet" Description="Looking for Tailscale…">
                    <ComboBox x:Name="TailnetCombo" MinWidth="280" PlaceholderText="Choose a device" SelectionChanged="TailnetCombo_SelectionChanged" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Sign in with">
                    <ComboBox x:Name="AuthCombo" MinWidth="280" SelectionChanged="AuthCombo_SelectionChanged">
                        <ComboBoxItem Content="Password" Tag="password" />
                        <ComboBoxItem Content="SSH key" Tag="key" />
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="PasswordCard" Header="Password" Description="Stored encrypted for your Windows account only.">
                    <PasswordBox x:Name="PasswordBox" MinWidth="280" PasswordChanged="PasswordBox_PasswordChanged" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="KeyCard" Header="Private key file">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="KeyPathBox" MinWidth="280" LostFocus="KeyPathBox_LostFocus" />
                        <Button Content="Browse" Click="BrowseKey_Click" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="PassphraseCard" Header="Key passphrase" Description="Only if your key has one.">
                    <PasswordBox x:Name="PassphraseBox" MinWidth="280" PasswordChanged="PassphraseBox_PasswordChanged" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Find AI on this server" Description="Looks for Hermes Agent, Ollama and other AI tools.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="DetectRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                        <Button x:Name="DetectButton" Content="Detect" Click="Detect_Click" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Name="UseKeyCard" Header="Sign in with a key instead"
                                      Description="Creates an SSH key for TileSmith, adds it to the server and forgets the password.">
                    <Button x:Name="UseKeyButton" Content="Set up key" Click="UseKey_Click" />
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
    </StackPanel>
</UserControl>
