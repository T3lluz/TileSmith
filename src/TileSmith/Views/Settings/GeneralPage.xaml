<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TileSmith.Views.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="4">
        <TextBlock Text="Startup" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,4" />
        <toolkit:SettingsCard Header="Start with Windows" Description="TileSmith waits quietly in the taskbar corner until you need it.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="StartupToggle" Toggled="StartupToggle_Toggled" />
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Always show the icon next to the clock"
                              Description="Otherwise Windows may tuck it away in the hidden icons (^) menu.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE75B;" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="IconToggle" Toggled="IconToggle_Toggled" />
        </toolkit:SettingsCard>

        <TextBlock Text="Opening the panel" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,24,0,4" />
        <toolkit:SettingsExpander Header="Keyboard shortcut" Description="Open or close the panel from anywhere." IsExpanded="True">
            <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE765;" /></toolkit:SettingsExpander.HeaderIcon>
            <ToggleSwitch x:Name="HotkeyToggle" Toggled="HotkeyToggle_Toggled" />
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard Header="Shortcut">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="HotkeyWarning" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center"
                                   Visibility="Collapsed" Text="Used by another app — pick another" />
                        <ComboBox x:Name="HotkeyCombo" MinWidth="200" SelectionChanged="HotkeyCombo_SelectionChanged" />
                    </StackPanel>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>

        <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,24,0,4" />
        <toolkit:SettingsCard Header="Panel style" Description="Solid is the rounded Android-style sheet; Glass uses Windows acrylic.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Name="StyleCombo" MinWidth="200" SelectionChanged="StyleCombo_SelectionChanged">
                <ComboBoxItem Content="Solid (rounded)" Tag="solid" />
                <ComboBoxItem Content="Glass (acrylic)" Tag="glass" />
            </ComboBox>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Accent colour" Description="Used for active tiles, sliders and the AI.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Name="AccentCombo" MinWidth="200" SelectionChanged="AccentCombo_SelectionChanged" />
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Panel width" Description="Automatic starts at 4 columns (about 4:3) and widens when you add lots of widgets.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE740;" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Name="ColumnsCombo" MinWidth="200" SelectionChanged="ColumnsCombo_SelectionChanged">
                <ComboBoxItem Content="Automatic" Tag="0" />
                <ComboBoxItem Content="Compact — 3 columns" Tag="3" />
                <ComboBoxItem Content="Standard — 4 columns" Tag="4" />
                <ComboBoxItem Content="Wide — 5 columns" Tag="5" />
            </ComboBox>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="App theme" Description="Choose light or dark, or follow Windows.">
            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></toolkit:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="RestartButton" Content="Restart to apply" Visibility="Collapsed" Click="RestartButton_Click" />
                <ComboBox x:Name="ThemeCombo" MinWidth="200" SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="Use system setting" Tag="system" />
                    <ComboBoxItem Content="Light" Tag="light" />
                    <ComboBoxItem Content="Dark" Tag="dark" />
                </ComboBox>
            </StackPanel>
        </toolkit:SettingsCard>
    </StackPanel>
</UserControl>
