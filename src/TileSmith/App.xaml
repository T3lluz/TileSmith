<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TileSmith.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PanelFooterBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="TileCardBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="TileCardStrokeBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ActivityBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#40000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PanelFooterBrush" Color="#0C000000" />
                    <SolidColorBrush x:Key="TileCardBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="TileCardStrokeBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ActivityBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#0A000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PanelFooterBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TileCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TileCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ActivityBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>

            <!-- Transparent button that only shows a fill on hover/press, like the icons in Quick Settings. -->
            <Style x:Key="SubtleIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
